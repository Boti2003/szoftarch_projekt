# =========================================================================
# Közös környezeti változók. Másold .env-be: cp .env.example .env
# Valódi titkok CSAK a .env-ben; az nincs verziókezelve.
# =========================================================================

# ---- PostgreSQL (egy konténer, négy logikai DB + külön user, D07) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# A superuser csak az init scripthez kell (DB-k és userek létrehozása).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# Service-enkénti DB és credential. A service csak a saját DB-userével csatlakozik.
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=change-me-identity

LEARNING_DB_NAME=learning_db
LEARNING_DB_USER=learning_user
LEARNING_DB_PASSWORD=change-me-learning

SOCIAL_DB_NAME=social_db
SOCIAL_DB_USER=social_user
SOCIAL_DB_PASSWORD=change-me-social

AI_DB_NAME=ai_db
AI_DB_USER=ai_user
AI_DB_PASSWORD=change-me-ai

# ---- JWT (RS256, D12 / 8. szakasz) ----
# A kulcspárt az infra/scripts/gen-jwt-keys script generálja a secrets/ mappába.
# A privát kulcs CSAK az Identity service-é; a többi csak a publikus kulcsot kapja.
JWT_ISSUER=szoftarch-nyelvtanulo
JWT_ACCESS_TOKEN_TTL_SECONDS=300
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

# ---- Belső service-to-service API kulcs (X-Internal-Api-Key, 8. szakasz) ----
# Legalább 32 bájt véletlen. A baseline egy közös kulcsot használ.
INTERNAL_API_KEY=change-me-at-least-32-bytes-random-value

# ---- AI provider (D14 / 5.6) ----
# fake = kulcs nélkül fut; openai-compatible = valódi modell a bemutatóhoz.
AI_PROVIDER=fake
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=20

# ---- Belső service URL-ek (Docker DNS, D09) ----
GATEWAY_URL=http://gateway:8080
IDENTITY_URL=http://identity-service:8080
LEARNING_URL=http://learning-service:8080
SOCIAL_URL=http://social-service:8080
AI_URL=http://ai-service:8080

# ---- Frontend / CORS (8. szakasz) ----
CORS_ALLOWED_ORIGIN=https://localhost

# ---- Napi kihívás üzleti időzóna (D17) ----
BUSINESS_TIMEZONE=Europe/Budapest
